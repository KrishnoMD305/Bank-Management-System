<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.controller.OpenAccountController"
      styleClass="root-pane">
    <padding>
        <Insets top="25" bottom="25" left="30" right="30"/>
    </padding>

    <Label text="Open New Account" styleClass="title-label"/>
    <Label text="Enter the customer's details to create their account" styleClass="subtitle-label"/>

    <VBox spacing="8" maxWidth="320">
        <Label text="Name"/>
        <TextField fx:id="fullNameField" promptText="Full name"/>
        <Label text="Phone Number"/>
        <TextField fx:id="phoneField" promptText="e.g. 017XXXXXXXX"/>
        <Label text="ID Type"/>
        <ComboBox fx:id="idTypeBox" maxWidth="Infinity"/>
        <Label text="NID / Driver License / Passport Number"/>
        <TextField fx:id="idNumberField" promptText="ID number"/>
        <Label text="Account Type"/>
        <ComboBox fx:id="accountTypeBox" maxWidth="Infinity"/>
        <Label text="Initial Deposit (৳)"/>
        <TextField fx:id="depositField" promptText="0.00"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="confirmButton" text="Open Account" onAction="#handleConfirm" styleClass="primary-button"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status-label"/>
</VBox>
