<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bank.controller.DashboardController" styleClass="root-pane"
            prefWidth="1000" prefHeight="650">

    <top>
        <VBox styleClass="header-bar">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="welcomeLabel" styleClass="title-label"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalBalanceLabel" styleClass="subtitle-label"/>
                <Button text="Refresh" onAction="#handleRefresh"/>
                <Button text="Logout" onAction="#handleLogout"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">
            <VBox spacing="10">
                <padding>
                    <Insets top="10" bottom="10" left="10" right="10"/>
                </padding>
                <Label text="Accounts" styleClass="section-label"/>
                <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAccNo" text="Account #" prefWidth="120"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                        <TableColumn fx:id="colBalance" text="Balance" prefWidth="100"/>
                        <TableColumn fx:id="colOwner" text="Owner" prefWidth="100"/>
                    </columns>
                </TableView>

                <TitledPane text="Open New Account" expanded="false">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <padding>
                            <Insets top="10" bottom="10" left="10" right="10"/>
                        </padding>
                        <Label text="Type:"/>
                        <ComboBox fx:id="newAccountTypeBox"/>
                        <Label text="Initial Deposit:"/>
                        <TextField fx:id="newAccountDepositField" prefWidth="100" promptText="0.00"/>
                        <Button text="Open Account" onAction="#handleNewAccount"/>
                    </HBox>
                </TitledPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Deposit" onAction="#handleDeposit"/>
                    <Button text="Withdraw" onAction="#handleWithdraw"/>
                    <Button text="Transfer" onAction="#handleTransfer"/>
                </HBox>
                <Label fx:id="statusLabel" styleClass="status-label"/>
            </VBox>

            <VBox spacing="10">
                <padding>
                    <Insets top="10" bottom="10" left="10" right="10"/>
                </padding>
                <Label text="Transaction History" styleClass="section-label"/>
                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTime" text="Time" prefWidth="140"/>
                        <TableColumn fx:id="colTxnType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colAmount" text="Amount" prefWidth="90"/>
                        <TableColumn fx:id="colBalanceAfter" text="Balance After" prefWidth="100"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
